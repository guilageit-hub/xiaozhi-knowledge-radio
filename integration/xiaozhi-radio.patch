+
+bool Application::QueueRadio(const std::string& name, const std::string& url) {
+#if CONFIG_ENABLE_RADIO_PLAYER
+    if (name.empty() || name.size() > 160 || url.empty() || url.size() > 2048) return false;
+    const auto ticket = radio_requests_.Advance();
+    Schedule([this, name, url, ticket]() {
+        if (!radio_requests_.IsCurrent(ticket)) return;
+        ClearRadio();
+        pending_radio_name_ = name;
+        pending_radio_url_ = url;
+        pending_radio_time_ = esp_timer_get_time();
+        pending_radio_ticket_ = ticket;
+        radio_pending_.store(true);
+    });
+    return true;
+#else
+    return false;
+#endif
+}
+
+void Application::StopRadio() {
+    const auto ticket = radio_requests_.Advance();
+    Schedule([this, ticket]() { if (radio_requests_.IsCurrent(ticket)) ClearRadio(); });
+}
+
+void Application::CancelRadio() {
+    radio_requests_.Advance();
+    ClearRadio();
+}
+
+void Application::ClearRadio() {
+    radio_pending_.store(false);
+    radio_player_.Stop();
+}
+
+std::string Application::RadioStatus() const {
+    return radio_pending_.load() ? "{\"state\":\"queued\"}" : radio_player_.Status();
+}
+
+void Application::ProcessPendingRadio() {
+    const bool active = radio_player_.IsActive();
+    if (radio_power_owned_ && !active && !radio_pending_.load()) {
+        const bool idle = GetDeviceState() == kDeviceStateIdle &&
+                          (!protocol_ || !protocol_->IsAudioChannelOpened());
+        if (radio::ReleasePower(radio_power_owned_, active, radio_pending_.load(), idle)) {
+            Board::GetInstance().SetPowerSaveLevel(PowerSaveLevel::LOW_POWER);
+        }
+        radio_power_owned_ = false;
+    }
+    if (!radio_pending_.load() || esp_timer_get_time() - pending_radio_time_ < 1000000) return;
+    if (!radio_requests_.IsCurrent(pending_radio_ticket_)) {
+        ClearRadio();
+        return;
+    }
+    // Let the MCP reply leave the device and any spoken confirmation finish first.
+    if (GetDeviceState() == kDeviceStateSpeaking || !audio_service_.IsPlaybackIdle()) {
+        if (esp_timer_get_time() - pending_radio_time_ > 30000000) CancelRadio();
+        return;
+    }
+    radio_pending_.store(false);
+    if (GetDeviceState() != kDeviceStateIdle && GetDeviceState() != kDeviceStateListening) return;
+    audio_service_.EnableVoiceProcessing(false);
+    if (protocol_ && protocol_->IsAudioChannelOpened()) protocol_->CloseAudioChannel();
+    SetDeviceState(kDeviceStateIdle);
+    Board::GetInstance().SetPowerSaveLevel(PowerSaveLevel::PERFORMANCE);
+    radio_power_owned_ = true;
+    radio_player_.Play(pending_radio_name_, pending_radio_url_);
 }
 
