+uint32_t AudioService::BeginExternalPlayback() {
+    std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+    if (++playback_generation_ == 0) ++playback_generation_;
+    external_playback_token_ = playback_generation_;
+    audio_decode_queue_.clear();
+    audio_playback_queue_.clear();
+    timestamp_queue_.clear();
+    audio_queue_cv_.notify_all();
+    return external_playback_token_;
+}
+
+bool AudioService::PushExternalPcm(uint32_t token, const int16_t* samples, size_t count) {
+    if (!token || !samples || !count || count > 960) return false;
+    std::unique_lock<std::mutex> lock(audio_queue_mutex_);
+    if (!audio_queue_cv_.wait_for(lock, std::chrono::milliseconds(250), [this, token]() {
+            return service_stopped_.load() || token != external_playback_token_ ||
+                   !audio_playback_queue_.full();
+        }) || service_stopped_.load() || token != external_playback_token_) return false;
+    AudioTask task;
+    task.type = kAudioTaskTypeDecodeToPlaybackQueue;
+    task.pcm.assign(samples, samples + count);
+    playback_drained_notified_ = false;
+    audio_playback_queue_.push_back(std::move(task));
+    audio_queue_cv_.notify_all();
+    return true;
+}
+
+void AudioService::EndExternalPlayback(uint32_t token) {
+    bool notify = false;
+    {
+        std::lock_guard<std::mutex> lock(audio_queue_mutex_);
+        if (!token || token != external_playback_token_) return;
+        external_playback_token_ = 0;
+        ++playback_generation_;
+        audio_playback_queue_.clear();
+        notify = MarkPlaybackDrainedLocked();
+        audio_queue_cv_.notify_all();
+    }
+    if (notify && callbacks_.on_playback_drained) callbacks_.on_playback_drained();
 }
 
